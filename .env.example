# Opcional. La sessió de Claude Code es fa amb `docker compose exec -T lema claude auth login`
# (vegeu web-local.md) i es guarda al volum de Docker. Esta línia només cal si preferixes un
# token de llarga durada (`claude setup-token`) en lloc d'eixa sessió.
CLAUDE_CODE_OAUTH_TOKEN=

# Opcional: model per a «Passa a net» (p. ex. sonnet). Buit: el per defecte de la subscripció.
LEMA_MODEL=
